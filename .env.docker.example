APP_NAME=EMIS
APP_ENV=local
# Set a persistent APP_KEY here (e.g. via `php artisan key:generate --show`)
# If left empty, the container entrypoint will generate one at startup.
# APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
DOCKER_APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nemis
DB_USERNAME=root
DB_PASSWORD=root

MYSQL_DATABASE=nemis
MYSQL_ROOT_PASSWORD=root
DOCKER_DB_PORT=3308

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="EMIS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT=5
OSRM_CONNECT_TIMEOUT=3
OSRM_VERIFY_SSL=true
OSRM_LOG_FAILURES=false

VITE_APP_NAME=EMIS

WSO2_ENABLED=true
WSO2_BASE_URL=https://identity.emis.moe.gov.lk:9444
WSO2_M2M_CLIENT_ID=
WSO2_M2M_CLIENT_SECRET=
WSO2_TEACHER_ROLE_ID=
WSO2_VERIFY_SSL=false
